# Portfolio defaults to the committed JSON file database at
# .data/bonds-portfolio.json. Set to "database" only when you want Postgres.
BONDS_PORTFOLIO_DATABASE=file

# Required for multi-user accounts and new users’ portfolios.
# With no connection, production preserves the original owner-only JSON login.
# BONDS_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Vercel's Neon integration supplies DATABASE_URL; this is also accepted.
# A connected database is prepared atomically during `npm run build`.
# After initial setup, a restricted runtime role can use this optional switch:
# BONDS_SKIP_DATABASE_MIGRATIONS=1

# Optional. Use only if you want a different file name inside .data/.
# BONDS_FILE_DATABASE_NAME=bonds-portfolio.json

# Required for the owner account in every mode. JSON owner login does not
# require a database, but needs these private credentials in Vercel.
BONDS_ADMIN_EMAIL=you@example.com

# Generate with: node scripts/hash-bonds-password.mjs 'a-long-unique-passphrase'
BONDS_ADMIN_PASSWORD_HASH=scrypt:salt:hexadecimal-scrypt-hash

# Optional one-friend account, separate from the owner. Share /create-password
# so your friend creates the hash in their browser and keeps their password private.
# Set these only in Vercel; do not commit real email/password-hash values.
# Synchronized friend purchases require the database above.
# BONDS_FRIEND_EMAIL=friend@example.com
# BONDS_FRIEND_PASSWORD_HASH=pbkdf2-sha256:600000:salt:hash

# Optional canonical origin for CSRF checks behind a reverse proxy. Set in production.
# BONDS_APP_ORIGIN=https://bonds.orestegabo.dev

# Optional development-only auth filename under the project-scoped OS temp directory.
# BONDS_AUTH_FILE_NAME=bonds-auth.json

# Optional. Protects /api/bonds/rse/snapshot when called by a scheduler.
# Send it as an Authorization: Bearer header, not as a URL query string.
BONDS_MARKET_SNAPSHOT_SECRET=replace-with-another-long-random-secret

# Required in Vercel Production for the daily equity collector in vercel.json.
# Vercel automatically sends this as Authorization: Bearer <secret>.
# Generate privately with: openssl rand -hex 32
# CRON_SECRET=replace-with-a-long-random-secret
